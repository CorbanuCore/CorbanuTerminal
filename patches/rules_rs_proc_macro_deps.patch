# What: keep Cargo proc-macro dependencies in rules_rust's exec configuration.
# Scope: rules_rs crate-universe generation and generated crate wrapper only.

diff --git a/rs/extensions.bzl b/rs/extensions.bzl
--- a/rs/extensions.bzl
+++ b/rs/extensions.bzl
@@ -74,6 +74,24 @@ def _additive_build_file_content(mctx, annotation):
     content += annotation.additive_build_file_content
     return content
 
+def _split_proc_macro_deps(deps_by_triple, proc_macro_fq_crates):
+    """Partitions resolved Cargo deps so proc macros use cfg=exec."""
+    normal = {}
+    proc_macros = {}
+    for triple, deps in deps_by_triple.items():
+        normal[triple] = set()
+        proc_macros[triple] = set()
+        for dep in deps:
+            target_name = dep.rsplit(":", 1)[-1]
+            if target_name in proc_macro_fq_crates:
+                proc_macros[triple].add(dep)
+            else:
+                normal[triple].add(dep)
+    return struct(
+        normal = normal,
+        proc_macros = proc_macros,
+    )
+
 def _generate_hub_and_spokes(
         mctx,
         hub_name,
@@ -279,6 +297,14 @@ def _generate_hub_and_spokes(
 
     use_home_cargo_credentials = bool(cargo_credentials)
 
+    proc_macro_fq_crates = set()
+    for metadata_package in cargo_metadata["packages"]:
+        if any([
+            "proc-macro" in target.get("kind", [])
+            for target in metadata_package.get("targets", [])
+        ]):
+            proc_macro_fq_crates.add(_fq_crate(metadata_package["name"], metadata_package["version"]))
+
     for package in packages:
         crate_name = package["name"]
         version = package["version"]
@@ -318,6 +344,7 @@ WARNING: A well-known crate annotation exists for {crate}! Apply the following
                 formatted_well_known_annotation = suggested_annotation,
             ))
 
+        split_deps = _split_proc_macro_deps(feature_resolutions.deps, proc_macro_fq_crates)
         kwargs = dict(
             hub_name = hub_name,
             gen_build_script = annotation.gen_build_script,
@@ -337,7 +364,8 @@ WARNING: A well-known crate annotation exists for {crate}! Apply the following
             data = annotation.data,
             deps = annotation.deps,
             crate_tags = annotation.tags,
-            deps_select = _select(feature_resolutions.deps),
+            deps_select = _select(split_deps.normal),
+            proc_macro_deps_select = _select(split_deps.proc_macros),
             aliases = feature_resolutions.aliases,
             crate_features = annotation.crate_features,
             crate_features_select = _select(feature_resolutions.features_enabled),
