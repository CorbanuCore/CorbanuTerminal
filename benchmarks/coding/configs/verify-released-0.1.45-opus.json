{
  "run_dir": "${CORBANU_BENCH_RUNS}/opus55-released-0.1.45-queuecraft",
  "waves": 1,
  "caps": {
    "timeout_seconds": 1200,
    "max_total_runs": 1
  },
  "isolation": {
    "mode": "docker",
    "images": {
      "corbanu": "corbanu-bench-corbanu:v0.1.45"
    },
    "upstream_key_env": "OPENROUTER_API_KEY",
    "cpus": "4",
    "memory": "8g"
  },
  "agents": [
    {
      "name": "corbanu-v0.1.45-opus-5.5",
      "kind": "corbanu",
      "binary": "corbanu",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-5.5",
      "lane": "released"
    }
  ],
  "tasks": [
    {
      "name": "queuecraft",
      "baseline": "../tasks/queuecraft/bugged",
      "prompt": "../tasks/queuecraft/bugged/BENCHMARK_TASK.md",
      "verifier": "../tasks/queuecraft/verifier/verify.py"
    }
  ]
}
