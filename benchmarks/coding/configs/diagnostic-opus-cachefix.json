{
  "run_dir": "${CORBANU_BENCH_RUNS}/opus55-cachefix-queryforge-queuecraft",
  "waves": 1,
  "caps": {
    "timeout_seconds": 1200,
    "max_total_runs": 4
  },
  "isolation": {
    "mode": "docker",
    "images": {
      "corbanu": "corbanu-bench-corbanu:c0.1.44-cachefix"
    },
    "upstream_key_env": "OPENROUTER_API_KEY",
    "cpus": "4",
    "memory": "8g"
  },
  "agents": [
    {
      "name": "corbanu-cachefix-opus-5.5",
      "kind": "corbanu",
      "binary": "corbanu",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-5.5",
      "lane": "cachefix-default"
    },
    {
      "name": "corbanu-cachefix-opus-5.5-medium",
      "kind": "corbanu",
      "binary": "corbanu",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-5.5",
      "lane": "cachefix-medium",
      "agent_args": [
        "-c",
        "model_reasoning_effort=\"medium\""
      ]
    }
  ],
  "tasks": [
    {
      "name": "queryforge",
      "baseline": "../tasks/queryforge/baseline",
      "prompt": "../tasks/queryforge/task_prompt.md",
      "verifier": "../tasks/queryforge/verifier/verify.py",
      "core_rel": "src/queryforge/__init__.py"
    },
    {
      "name": "queuecraft",
      "baseline": "../tasks/queuecraft/bugged",
      "prompt": "../tasks/queuecraft/bugged/BENCHMARK_TASK.md",
      "verifier": "../tasks/queuecraft/verifier/verify.py"
    }
  ]
}
