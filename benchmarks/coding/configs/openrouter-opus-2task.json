{
  "run_dir": "${CORBANU_BENCH_RUNS}/opus55-queryforge-queuecraft",
  "waves": 1,
  "caps": {
    "timeout_seconds": 1200,
    "max_total_runs": 6
  },
  "isolation": {
    "mode": "docker",
    "images": {
      "corbanu": "corbanu-bench-corbanu:c0.1.44-h2026.9.21-k7.7.9",
      "hermes": "corbanu-bench-hermes:c0.1.44-h2026.9.21-k7.7.9",
      "kilo": "corbanu-bench-kilo:c0.1.44-h2026.9.21-k7.7.9"
    },
    "upstream_key_env": "OPENROUTER_API_KEY",
    "cpus": "4",
    "memory": "8g"
  },
  "agents": [
    {
      "name": "corbanu-opus-5.5",
      "kind": "corbanu",
      "binary": "corbanu",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-5.5",
      "lane": "corbanu-opus-5.5"
    },
    {
      "name": "hermes-opus-5.5",
      "kind": "hermes",
      "binary": "hermes",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-5.5",
      "lane": "hermes-opus-5.5"
    },
    {
      "name": "kilo-opus-5.5",
      "kind": "kilo",
      "binary": "kilo",
      "provider": "openrouter",
      "model": "anthropic/claude-opus-5.5",
      "lane": "kilo-opus-5.5"
    }
  ],
  "tasks": [
    {
      "name": "queryforge",
      "baseline": "../tasks/queryforge/baseline",
      "prompt": "../tasks/queryforge/task_prompt.md",
      "verifier": "../tasks/queryforge/verifier/verify.py",
      "core_rel": "src/queryforge/__init__.py"
    },
    {
      "name": "queuecraft",
      "baseline": "../tasks/queuecraft/bugged",
      "prompt": "../tasks/queuecraft/bugged/BENCHMARK_TASK.md",
      "verifier": "../tasks/queuecraft/verifier/verify.py"
    }
  ]
}
