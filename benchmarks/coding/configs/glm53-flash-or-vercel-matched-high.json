{
  "run_dir": "${CORBANU_BENCH_RUNS}/glm53-flash-or-vercel-matched-high",
  "waves": 2,
  "caps": {
    "timeout_seconds": 1200,
    "max_total_runs": 32
  },
  "isolation": {
    "mode": "docker",
    "images": {
      "corbanu": "corbanu-bench-corbanu:c0.1.45-solfix2",
      "hermes": "corbanu-bench-hermes:c0.1.44-h2026.9.21-k7.7.9"
    },
    "upstream_key_env": "OPENROUTER_API_KEY",
    "cpus": "4",
    "memory": "8g"
  },
  "agents": [
    {
      "name": "corbanu-glm-5.3-openrouter-high",
      "kind": "corbanu",
      "binary": "corbanu",
      "provider": "openrouter",
      "model": "z-ai/glm-5.3",
      "lane": "corbanu-glm-5.3-openrouter",
      "agent_args": [
        "-c",
        "model_reasoning_effort=\"high\""
      ]
    },
    {
      "name": "hermes-glm-5.3-openrouter-high",
      "kind": "hermes",
      "binary": "hermes",
      "provider": "openrouter",
      "model": "z-ai/glm-5.3",
      "lane": "hermes-glm-5.3-openrouter",
      "agent_args": [
        "--reasoning",
        "high"
      ]
    },
    {
      "name": "corbanu-glm-5.3-vercel-high",
      "kind": "corbanu",
      "binary": "corbanu",
      "provider": "vercel",
      "model": "zai/glm-5.3",
      "lane": "corbanu-glm-5.3-vercel",
      "agent_args": [
        "-c",
        "model_reasoning_effort=\"high\""
      ],
      "cli_model": "zai/glm-5.3"
    },
    {
      "name": "hermes-glm-5.3-vercel-high",
      "kind": "hermes",
      "binary": "hermes",
      "provider": "vercel",
      "model": "zai/glm-5.3",
      "lane": "hermes-glm-5.3-vercel",
      "agent_args": [
        "--reasoning",
        "high"
      ]
    },
    {
      "name": "corbanu-glm-5.3-flash-openrouter-high",
      "kind": "corbanu",
      "binary": "corbanu",
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "lane": "corbanu-glm-5.3-flash-openrouter",
      "agent_args": [
        "-c",
        "model_reasoning_effort=\"high\""
      ]
    },
    {
      "name": "hermes-glm-5.3-flash-openrouter-high",
      "kind": "hermes",
      "binary": "hermes",
      "provider": "openrouter",
      "model": "z-ai/glm-5.3-flash",
      "lane": "hermes-glm-5.3-flash-openrouter",
      "agent_args": [
        "--reasoning",
        "high"
      ]
    },
    {
      "name": "corbanu-glm-5.3-flash-vercel-high",
      "kind": "corbanu",
      "binary": "corbanu",
      "provider": "vercel",
      "model": "zai/glm-5.3-flash",
      "lane": "corbanu-glm-5.3-flash-vercel",
      "agent_args": [
        "-c",
        "model_reasoning_effort=\"high\""
      ],
      "cli_model": "zai/glm-5.3-flash"
    },
    {
      "name": "hermes-glm-5.3-flash-vercel-high",
      "kind": "hermes",
      "binary": "hermes",
      "provider": "vercel",
      "model": "zai/glm-5.3-flash",
      "lane": "hermes-glm-5.3-flash-vercel",
      "agent_args": [
        "--reasoning",
        "high"
      ]
    }
  ],
  "tasks": [
    {
      "name": "queryforge",
      "baseline": "../tasks/queryforge/baseline",
      "prompt": "../tasks/queryforge/task_prompt.md",
      "verifier": "../tasks/queryforge/verifier/verify.py",
      "core_rel": "src/queryforge/__init__.py"
    },
    {
      "name": "queuecraft",
      "baseline": "../tasks/queuecraft/bugged",
      "prompt": "../tasks/queuecraft/bugged/BENCHMARK_TASK.md",
      "verifier": "../tasks/queuecraft/verifier/verify.py"
    }
  ]
}
