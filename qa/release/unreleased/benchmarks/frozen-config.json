  "hermes_efficiency": {
    "purpose": "evidence for or against the claim that Corbanu is more efficient than Hermes; Kilo runs alongside as the third competitor",
    "route": {
      "provider": "openrouter",
      "model": "openai/gpt-6-sol",
      "hermes_model": "openai/gpt-6-sol",
      "kilo_model": "openrouter/openai/gpt-6-sol",
      "reasoning": "high",
      "required_env": [
        "OPENROUTER_API_KEY"
      ],
      "why": "gpt-6-sol is Corbanu's default model; OpenRouter is an OpenAI-style connection every harness supports, so all three see the same model, endpoint and price list"
    },
    "waves": 3,
    "lanes": "one lane per harness (three concurrent processes on one OpenRouter key)",
    "decision_rule": {
      "correctness_gate": "Corbanu verifier passes >= Hermes passes - 1 over the 33 task x wave runs, and Corbanu meets the live task rubric in at least 2 of 3 repeats",
      "primary_metric": "per-pair cost ratio Corbanu/Hermes for each task x wave where both runs finished with known spend",
      "estimate": "geometric mean of the ratios",
      "interval": "95% percentile bootstrap, resampling tasks (all waves of a task together), 10,000 resamples, seed 2717; bounds are the 250th smallest and 250th largest resampled values",
      "claim_if": "correctness gate met and the interval's upper bound <= 0.95: publish 'Corbanu used X% less spend than Hermes (95% CI a-b%)' with the point estimate and interval",
      "no_claim_if": "any other outcome (including an upper bound above 0.95, or a failed correctness gate): publish nothing",
      "regression_if": "the interval's lower bound > 1.05 (Corbanu costs more): file a regression issue instead of a claim",
      "secondary": "the same procedure for wall time and total tokens; report them separately, never fold them into the spend claim"
    },
    "planned_runs": 99
  },
