{
  "name": "@agticorp/ambient-crypto-gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "accounting": "node dist/accounting.js",
    "build": "tsc -p tsconfig.build.json",
    "key:issue": "tsx src/issue-key.ts",
    "qualify:live": "tsx src/live-purchase.ts",
    "start": "node dist/index.js",
    "test": "tsx --test --test-concurrency=1 tests/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "wallet:generate": "tsx src/generate-wallet.ts"
  },
  "dependencies": {
    "@x402/core": "2.18.0",
    "@x402/express": "2.18.0",
    "@x402/extensions": "2.18.0",
    "@x402/fetch": "2.18.0",
    "@x402/svm": "2.18.0",
    "@noble/curves": "1.9.7",
    "@scure/base": "1.2.6",
    "@solana/kit": "5.5.1",
    "express": "5.2.1",
    "pg": "8.16.3"
  },
  "devDependencies": {
    "@types/express": "5.0.3",
    "@types/node": "22.18.6",
    "@types/pg": "8.15.5",
    "@types/supertest": "6.0.3",
    "supertest": "7.1.4",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
