#!/usr/bin/env python3
"""Run a two-turn native-provider benchmark through the real PFTerminal TUI."""

from __future__ import annotations

import argparse
import json
import os
import pty
import re
import select
import subprocess
import sys
import time
from pathlib import Path


REPO_ROOT = Path(__file__).resolve().parents[1]
DEFAULT_BINARY = REPO_ROOT / "codex-rs" / "target" / "debug" / "pfterminal"
ANSI_RE = re.compile(
    r"(?:\x1b\][^\x07]*(?:\x07|\x1b\\))|(?:\x1b\[[0-?]*[ -/]*[@-~])|(?:\x1b[=>][0-9;]*[a-zA-Z])"
)
STREAM_OK_RE = re.compile(r"\[pfterminal-stream\] (?:anthropic|chat|responses)_http_stream_request_ok elapsed_ms=(\d+)")
STREAM_DONE_RE = re.compile(r"\[pfterminal-stream\] response_stream_completed elapsed_ms=(\d+)")
CLIENT_SETUP_RE = re.compile(r"\[pfterminal-stream\] (?:anthropic|chat|responses)_http_after_client_setup elapsed_ms=(\d+)")
TOKEN_USAGE_RE = re.compile(
    r"Token usage: total=(?P<total>[\d,]+) input=(?P<input>[\d,]+) "
    r"\(\+ (?P<cached>[\d,]+) cached\) output=(?P<output>[\d,]+)"
)


def strip_ansi(value: str) -> str:
    return ANSI_RE.sub("", value)


def parse_numbers(pattern: re.Pattern[str], text: str) -> list[int]:
    return [int(match.group(1)) for match in pattern.finditer(text)]


def parse_token_usage(text: str) -> dict[str, int] | None:
    matches = list(TOKEN_USAGE_RE.finditer(text))
    if not matches:
        return None
    match = matches[-1]
    return {
        key: int(value.replace(",", ""))
        for key, value in match.groupdict().items()
    }


def effective_home(binary: Path, env: dict[str, str]) -> Path:
    """Resolve the state home using the same entrypoint contract as PFTerminal."""
    if binary.name == "pfterminal-debug":
        return Path(env.get("PFTERMINAL_DEBUG_HOME", Path.home() / ".pfterminal-debug"))
    if binary.name == "pfterminal":
        return Path(env.get("PFTERMINAL_HOME", Path.home() / ".pfterminal"))
    return Path(env.get("CODEX_HOME", Path.home() / ".codex"))


def matching_rollout(
    session_root: Path,
    existing: set[Path],
    provider: str,
    first_prompt: str,
) -> Path | None:
    if not session_root.exists():
        return None
    candidates = sorted(
        (path for path in session_root.rglob("*.jsonl") if path not in existing),
        key=lambda path: path.stat().st_mtime_ns,
        reverse=True,
    )
    for path in candidates:
        saw_provider = False
        saw_prompt = False
        try:
            for line in path.read_text(errors="replace").splitlines():
                record = json.loads(line)
                if record.get("type") == "session_meta":
                    saw_provider = record.get("payload", {}).get("model_provider") == provider
                elif record.get("type") == "response_item":
                    payload = record.get("payload", {})
                    if payload.get("type") == "message" and payload.get("role") == "user":
                        saw_prompt = any(
                            item.get("type") == "input_text" and item.get("text") == first_prompt
                            for item in payload.get("content", [])
                            if isinstance(item, dict)
                        )
                if saw_provider and saw_prompt:
                    return path
        except (OSError, json.JSONDecodeError):
            continue
    return None


def rollout_for_session(session_root: Path, session_id: str) -> Path | None:
    if not session_root.exists():
        return None
    for path in session_root.rglob("*.jsonl"):
        try:
            first_line = path.open(errors="replace").readline()
            record = json.loads(first_line)
        except (OSError, json.JSONDecodeError):
            continue
        if (
            record.get("type") == "session_meta"
            and record.get("payload", {}).get("id") == session_id
        ):
            return path
    return None


def persisted_completed_turns(rollout: Path | None) -> int:
    if rollout is None:
        return 0
    provider_responses: set[str] = set()
    terminal_turns: set[str] = set()
    try:
        for line in rollout.read_text(errors="replace").splitlines():
            record = json.loads(line)
            if record.get("type") != "event_msg":
                continue
            payload = record.get("payload", {})
            turn_id = payload.get("turn_id")
            if not isinstance(turn_id, str):
                continue
            if payload.get("type") == "model_response_completed":
                provider_responses.add(turn_id)
            elif payload.get("type") == "task_complete":
                terminal_turns.add(turn_id)
    except (OSError, json.JSONDecodeError):
        return 0
    # A local validation failure can still emit task_complete. Count only turns
    # that also crossed the provider-response boundary so the benchmark cannot
    # report a missing-metadata or authentication failure as success.
    return len(provider_responses & terminal_turns)


def persisted_function_calls(rollout: Path | None) -> int:
    if rollout is None:
        return 0
    calls = 0
    try:
        for line in rollout.read_text(errors="replace").splitlines():
            record = json.loads(line)
            if (
                record.get("type") == "response_item"
                and record.get("payload", {}).get("type") == "function_call"
            ):
                calls += 1
    except (OSError, json.JSONDecodeError):
        return 0
    return calls


def provider_key_from_vault(binary: Path, vault_label: str) -> str:
    result = subprocess.run(
        [str(binary), "vault", "auth-helper", vault_label],
        cwd=REPO_ROOT / "codex-rs",
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=True,
    )
    key = result.stdout.strip()
    if not key:
        raise RuntimeError(f"vault helper returned an empty key for {vault_label}")
    return key


def read_available(master_fd: int) -> str:
    chunks: list[bytes] = []
    while True:
        ready, _, _ = select.select([master_fd], [], [], 0)
        if not ready:
            break
        try:
            chunk = os.read(master_fd, 65536)
        except OSError:
            break
        if not chunk:
            break
        chunks.append(chunk)
    return b"".join(chunks).decode("utf-8", errors="replace")


def run_benchmark(args: argparse.Namespace) -> dict[str, object]:
    binary = Path(args.binary).resolve()
    if args.key_env not in os.environ:
        os.environ[args.key_env] = provider_key_from_vault(binary, args.vault_label)

    env = os.environ.copy()
    env["PFTERMINAL_TRACE_STREAM_TIMING"] = "1"
    if args.dump_request:
        dump_api = args.dump_request_api
        if dump_api == "auto":
            dump_api = "anthropic" if "anthropic" in args.provider else "chat"
        dump_env_var = {
            "anthropic": "PFTERMINAL_DUMP_ANTHROPIC_REQUEST",
            "chat": "PFTERMINAL_DUMP_CHAT_REQUEST",
            "responses": "PFTERMINAL_DUMP_RESPONSES_REQUEST",
        }[dump_api]
        env[dump_env_var] = args.dump_request

    session_root = effective_home(binary, env) / "sessions"
    existing_rollouts = set(session_root.rglob("*.jsonl")) if session_root.exists() else set()
    rollout_path = (
        rollout_for_session(session_root, args.resume_session)
        if args.resume_session
        else None
    )
    if args.resume_session and rollout_path is None:
        raise RuntimeError(f"resume session {args.resume_session} has no persisted rollout")
    baseline_completed_turns = persisted_completed_turns(rollout_path)
    baseline_function_calls = persisted_function_calls(rollout_path)

    cmd = [
        str(binary),
        "--yolo",
        "--no-alt-screen",
        "-c",
        f'model_provider="{args.provider}"',
        "-m",
        args.model,
    ]
    if args.resume_session:
        cmd.extend(["resume", args.resume_session, args.turn1])
    else:
        cmd.append(args.turn1)

    master_fd, slave_fd = pty.openpty()
    started_at = time.monotonic()
    proc = subprocess.Popen(
        cmd,
        cwd=REPO_ROOT / "codex-rs",
        env=env,
        stdin=slave_fd,
        stdout=slave_fd,
        stderr=slave_fd,
        text=False,
        close_fds=True,
    )
    os.close(slave_fd)

    raw_output = ""
    second_prompt_written = False
    second_enter_sent = False
    second_prompt_at = 0.0
    first_completion_at: float | None = None
    deadline = started_at + args.timeout
    completed_turns = 0
    benchmark_complete = False

    try:
        while time.monotonic() < deadline:
            ready, _, _ = select.select([master_fd], [], [], 0.25)
            if ready:
                raw_output += read_available(master_fd)

            clean = strip_ansi(raw_output)
            stream_done = parse_numbers(STREAM_DONE_RE, clean)
            if rollout_path is None:
                rollout_path = matching_rollout(
                    session_root,
                    existing_rollouts,
                    args.provider,
                    args.turn1,
                )
            persisted_new_turns = max(
                0,
                persisted_completed_turns(rollout_path) - baseline_completed_turns,
            )
            completed_turns = max(
                len(stream_done),
                persisted_new_turns,
            )
            if first_completion_at is None and completed_turns >= 1:
                first_completion_at = time.monotonic()

            if (
                not second_prompt_written
                and first_completion_at is not None
                and time.monotonic() - first_completion_at >= 0.75
            ):
                os.write(master_fd, args.turn2.encode())
                second_prompt_written = True
                second_prompt_at = time.monotonic()

            if (
                second_prompt_written
                and not second_enter_sent
                and time.monotonic() - second_prompt_at >= 0.25
            ):
                os.write(master_fd, b"\r")
                second_enter_sent = True

            if second_enter_sent and completed_turns >= 2:
                benchmark_complete = True
                break

            if proc.poll() is not None:
                break

        if proc.poll() is None:
            if benchmark_complete:
                time.sleep(0.75)
                raw_output += read_available(master_fd)
            os.write(master_fd, b"\x03")
            time.sleep(1.0)
            raw_output += read_available(master_fd)
            try:
                proc.wait(timeout=10)
            except subprocess.TimeoutExpired:
                os.write(master_fd, b"\x03")
                time.sleep(1.0)
                raw_output += read_available(master_fd)
                try:
                    proc.wait(timeout=5)
                except subprocess.TimeoutExpired:
                    proc.kill()
                    proc.wait(timeout=5)
    finally:
        try:
            os.close(master_fd)
        except OSError:
            pass

    clean = strip_ansi(raw_output)
    function_calls = max(
        0,
        persisted_function_calls(rollout_path) - baseline_function_calls,
    )
    requirements_met = not args.require_tool_call or function_calls > 0
    return {
        "provider": args.provider,
        "model": args.model,
        "resume_session": args.resume_session,
        "turns_completed": completed_turns,
        "function_calls": function_calls,
        "rendered_ok_count": clean.count("• OK"),
        "second_prompt_submitted": second_enter_sent,
        "exit_code": proc.returncode,
        "wall_ms": int((time.monotonic() - started_at) * 1000),
        "client_setup_ms": parse_numbers(CLIENT_SETUP_RE, clean),
        "stream_request_ok_ms": parse_numbers(STREAM_OK_RE, clean),
        "stream_completed_ms": parse_numbers(STREAM_DONE_RE, clean),
        "token_usage": parse_token_usage(clean),
        "resume_hint": next(
            (line for line in clean.splitlines() if line.startswith("To continue this session,")),
            None,
        ),
        "rollout_path": str(rollout_path) if rollout_path is not None else None,
        "session_root": str(session_root),
        "success": second_enter_sent and completed_turns >= 2 and requirements_met,
    }


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--binary", default=str(DEFAULT_BINARY))
    parser.add_argument("--provider", default="vercel-anthropic-fast")
    parser.add_argument("--model", default="zai/glm-5.2-fast")
    parser.add_argument("--key-env", default="AI_GATEWAY_API_KEY")
    parser.add_argument("--vault-label", default="provider/ai_gateway_api_key")
    parser.add_argument("--timeout", type=float, default=90.0)
    parser.add_argument(
        "--resume-session",
        help="Resume this exact persisted session instead of creating a new one.",
    )
    parser.add_argument("--dump-request")
    parser.add_argument(
        "--require-tool-call",
        action="store_true",
        help="Fail unless the persisted session contains at least one model function call.",
    )
    parser.add_argument(
        "--dump-request-api",
        choices=["auto", "anthropic", "chat", "responses"],
        default="auto",
    )
    parser.add_argument("--turn1", default="PFT_TUI_NATIVE_ANTHROPIC_BENCH_1 Reply with exactly OK.")
    parser.add_argument("--turn2", default="PFT_TUI_NATIVE_ANTHROPIC_BENCH_2 Reply with exactly OK.")
    parser.add_argument("--output")
    args = parser.parse_args()

    result = run_benchmark(args)
    encoded = json.dumps(result, indent=2, sort_keys=True)
    if args.output:
        Path(args.output).write_text(encoded + "\n")
    print(encoded)
    return 0 if result["success"] else 1


if __name__ == "__main__":
    sys.exit(main())
