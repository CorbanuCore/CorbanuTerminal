load("//:defs.bzl", "MACOS_WEBRTC_RUSTC_LINK_FLAGS", "codex_rust_crate")

codex_rust_crate(
    name = "tui",
    binaries_with_build_commit = ["codex-tui"],
    compile_data = glob([
        "assets/**",
    ]),
    crate_name = "codex_tui",
    extra_binaries = [
        "//codex-rs/cli:codex",
    ],
    integration_compile_data_extra = ["src/test_backend.rs"],
    # The tmux end-to-end tests are owned by the `tmux smoke` workflow, which
    # installs tmux, builds `corbanu-walletd` beside the candidate binary and
    # runs them serially with CORBANU_TMUX_REQUIRED=1. Bazel's strict action
    # env and package layout cannot provide those prerequisites.
    integration_test_args = [
        "--skip",
        "tmux",
    ],
    rustc_flags_extra = MACOS_WEBRTC_RUSTC_LINK_FLAGS,
    test_data_extra = glob([
        "src/**/*.rs",
        "src/**/snapshots/**",
        "tests/fixtures/**",
    ]),
    test_shard_counts = {
        "tui-unit-tests": 8,
    },
    # The startup symlink test applies its own Seatbelt policy, which cannot be nested.
    test_tags = ["no-sandbox"],
    unit_test_srcs = glob([
        "src/**/*_test_support.rs",
        "src/**/*_tests.rs",
        "src/**/*_tests/**/*.rs",
        "src/**/test_fixtures.rs",
        "src/**/test_support.rs",
        "src/**/tests.rs",
        "src/**/tests/**/*.rs",
    ]) + ["src/test_backend.rs"],
)
